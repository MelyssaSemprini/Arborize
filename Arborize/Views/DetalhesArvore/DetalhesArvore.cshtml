<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Árvore Detalhes</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Aclonica&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/detalhesArvore.css">
</head>
<body>
    <div class="container">
        <header>
            <div class="header-content">
                <h1>Árvore Detalhes</h1>
                <div class="buttons">
                    <button class="close-btn">Fechar</button>
                    <button class="edit-btn">Editar</button>
                </div>
            </div>
            <p>Informação detalhada sobre a árvore</p>
        </header>
        <div class="details">
            <div class="detail-card">
                <div class="icon"><i class="bi bi-tree-fill"></i></div> <!-- Ícone de árvore atualizado -->
                <h2>Espécie</h2>
                <p>@Model.NomeEspecie</p>
            </div>
            <div class="detail-card">
                <div class="icon"><i class="bi bi-geo-alt"></i></div>
                <h2>Geolocalização</h2>
                <p>@Model.Latitude, @Model.Longitude</p>
            </div>
            <div class="detail-card">
                <div class="icon"><i class="bi bi-calendar"></i></div>
                <h2>Data de Plantio</h2>
                <p>@Model.DataPlantio.ToString("dd 'de' MMMM 'de' yyyy")</p>
            </div>
            <div class="detail-card">
                <div class="icon"><i class="bi bi-globe"></i></div>
                <h2>Origem</h2>
                <p>@Model.OrigemArv</p>
            </div>
            <div class="detail-card">
                <div class="icon"><i class="bi bi-lightbulb"></i></div>
                <h2>Curiosidade</h2>
                <p>@Model.Curiosidade</p>
            </div>
            <div class="detail-card">
                <div class="icon"><i class="bi bi-file-earmark-text"></i></div>
                <h2>Descrição</h2>
                <p>@Model.DescricaoArv</p>
            </div>
        </div>
        
    </div>
</body>
</html>
